# Локальні ключі для `npm run dev` (не комітити).
# Скопіюй як .env.local і встав свої. Без ключів — режим ● local.

# Supabase (отримай у Supabase Project Settings → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Debug режим: true увімкнути панель дебагу і версію UI (за замовчуванням true в dev, false в build)
# VITE_APP_DEBUG=true

# URL для QR-коду шарінгу на телефон (за замовчуванням https://fog-0tou.onrender.com/)
# VITE_SHARE_URL=https://fog-0tou.onrender.com/
